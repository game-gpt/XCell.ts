{
    "name": "@game-gpt/xcell-config",
    "version": "0.1.0",
    "description": "XCell Config - TOML configuration parsing and management",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.mjs",
            "require": "./dist/index.js",
            "types": "./dist/index.d.ts"
        }
    },
    "files": ["dist"],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "keywords": ["xcell", "config", "toml"],
    "license": "MPL-2.0",
    "dependencies": {
        "@game-gpt/xcell-core": "workspace:*",
        "smol-toml": "^1.3.1"
    },
    "devDependencies": {
        "tsup": "^8.0.0",
        "typescript": "^5.7.0",
        "vitest": "^2.1.0"
    }
}
